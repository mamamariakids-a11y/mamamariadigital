<%- include('../partials/header') %>

<div class="page-actions">
  <div>
    <h1>تغيير كلمة المرور</h1>
    <div class="sub">حدّثي كلمة مرور حسابك الخاص</div>
  </div>
</div>

<div class="card" style="max-width:480px;">
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

  <form method="POST" action="/account/change-password">
    <div class="form-group">
      <label class="field-label">كلمة المرور الحالية</label>
      <input type="password" name="current_password" required />
    </div>
    <div class="form-group">
      <label class="field-label">كلمة المرور الجديدة</label>
      <input type="password" name="new_password" required minlength="6" />
      <div class="form-hint">6 أحرف على الأقل</div>
    </div>
    <div class="form-group mt-0">
      <label class="field-label">تأكيد كلمة المرور الجديدة</label>
      <input type="password" name="confirm_password" required minlength="6" />
    </div>
    <button type="submit" class="btn btn-primary btn-block"><i class="fa-solid fa-key"></i> تحديث كلمة المرور</button>
  </form>
</div>

<%- include('../partials/footer') %>
