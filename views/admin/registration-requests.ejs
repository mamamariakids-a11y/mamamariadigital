<%- include('../partials/header') %>

<%
  const statusLbl = { pending: 'قيد المراجعة', approved: 'مقبول', rejected: 'مرفوض' };
  const statusBadge = { pending: 'badge-important', approved: 'badge-executed', rejected: 'badge-urgent' };
%>

<div class="page-actions">
  <div>
    <h1>طلبات التسجيل الذاتي</h1>
    <div class="sub">مراجعة طلبات حسابات أولياء الأمور الجديدة قبل تفعيلها</div>
  </div>
</div>

<div class="card mt-0">
  <div class="card-title">بانتظار المراجعة (<%= pending.length %>)</div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>الاسم</th><th>البريد</th><th>الهاتف</th><th>اسم الطفل</th><th>ملاحظات</th><th></th></tr></thead>
      <tbody>
        <% pending.forEach(function(r) { %>
          <tr>
            <td style="font-weight:700;"><%= r.name %></td>
            <td><%= r.email %></td>
            <td><%= r.phone || '—' %></td>
            <td><%= r.child_name || '—' %></td>
            <td class="text-muted"><%= r.notes || '—' %></td>
            <td>
              <div class="gap-8" style="flex-wrap:wrap;">
                <form method="POST" action="/admin/registration-requests/<%= r.id %>/approve" style="display:flex; gap:6px;">
                  <% if (r.child_name) { %>
                    <select name="class_id" style="min-width:110px;">
                      <option value="">بدون فصل</option>
                      <% classes.forEach(function(cl) { %>
                        <option value="<%= cl.id %>"><%= cl.name %></option>
                      <% }) %>
                    </select>
                  <% } %>
                  <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-check"></i> قبول</button>
                </form>
                <form method="POST" action="/admin/registration-requests/<%= r.id %>/reject" onsubmit="return confirm('رفض هذا الطلب؟');">
                  <button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-xmark"></i> رفض</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (!pending.length) { %><tr><td colspan="6" class="text-muted">لا توجد طلبات بانتظار المراجعة</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="card-title">آخر الطلبات المراجَعة</div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>الاسم</th><th>البريد</th><th>الحالة</th><th>تاريخ المراجعة</th></tr></thead>
      <tbody>
        <% reviewed.forEach(function(r) { %>
          <tr>
            <td><%= r.name %></td>
            <td><%= r.email %></td>
            <td><span class="badge <%= statusBadge[r.status] %>"><%= statusLbl[r.status] %></span></td>
            <td><%= r.reviewed_at ? dayjs(r.reviewed_at).format('DD/MM/YYYY HH:mm') : '—' %></td>
          </tr>
        <% }) %>
        <% if (!reviewed.length) { %><tr><td colspan="4" class="text-muted">لا يوجد سجل بعد</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
