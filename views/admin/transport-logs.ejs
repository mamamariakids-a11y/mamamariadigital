<%- include('../partials/header') %>

<div class="page-actions">
  <div>
    <h1>سجل النقل — <%= route.name %></h1>
    <div class="sub">متابعة رصد صعود/نزول الأطفال في تاريخ محدد</div>
  </div>
  <a href="/transport" class="btn btn-secondary btn-sm"><i class="fa-solid fa-arrow-right"></i> رجوع للخطوط</a>
</div>

<div class="card mt-0">
  <form method="GET" action="/transport/<%= route.id %>/logs" style="display:flex; gap:10px; align-items:end; margin-bottom:16px;">
    <div class="form-group mt-0" style="margin-bottom:0;">
      <label class="field-label">التاريخ</label>
      <input type="date" name="date" value="<%= date %>" onchange="this.form.submit()" />
    </div>
  </form>

  <div class="table-wrap">
    <table>
      <thead><tr><th>الطفل</th><th>الرحلة</th><th>الحالة</th><th>وقت الرصد</th></tr></thead>
      <tbody>
        <% const tripLbl = { morning: 'صباحًا', evening: 'مساءً' }; %>
        <% const statusLbl = { pending: 'بالانتظار', boarded: 'صعد', dropped: 'نزل', absent: 'غائب' }; %>
        <% const statusBadge = { pending: 'badge-pending', boarded: 'badge-received', dropped: 'badge-executed', absent: 'badge-urgent' }; %>
        <% logs.forEach(function(l) { %>
          <tr>
            <td style="font-weight:700;"><%= l.child_name %></td>
            <td><%= tripLbl[l.trip] %></td>
            <td><span class="badge <%= statusBadge[l.status] %>"><%= statusLbl[l.status] %></span></td>
            <td><%= l.marked_at ? dayjs(l.marked_at).format('HH:mm') : '—' %></td>
          </tr>
        <% }) %>
        <% if (!logs.length) { %><tr><td colspan="4" class="text-muted">لا يوجد سجل لهذا التاريخ</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
